# ============================================
# Alphard — Required environment variables
# ============================================
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit secrets.

# ---- Broker: Tinkoff Invest ----
# Get from: https://www.tbank.ru/invest/settings/api
# Sandbox token first — never use real token for development!
TINKOFF_SANDBOX_TOKEN=
TINKOFF_REAL_TOKEN=

# ---- Database ----
POSTGRES_USER=alphard
# POSTGRES_PASSWORD is REQUIRED. Fail-fast: docker compose / portainer
# will not start without it. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=alphard
# POSTGRES_TRUST_SUBNET controls the pg_hba.conf trust range injected by
# the pg-init service (and scripts/init_postgres.sh on recovery).
# Default: 172.16.0.0/12 (Docker bridge range, RFC1918). Override only
# if your alphard-net bridge lives elsewhere (e.g. 172.18.0.0/16) or
# if you want to disable trust entirely (set to 127.0.0.0/32 — verify
# password auth first). See issue #97 for the rationale.
POSTGRES_TRUST_SUBNET=172.16.0.0/12

# ---- Redis ----
# REDIS_PASSWORD is REQUIRED. Fail-fast: docker compose / portainer
# will not start without it. Generate: openssl rand -base64 24
REDIS_PASSWORD=

# ---- LLM endpoints ----
# (configured out-of-band via $AUX_LLM_MODEL / $MAIN_LLM_MODEL in deploy env)
# AUX_LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# MAIN_LLM_MODEL=deepseek/deepseek-v4-flash-0731

