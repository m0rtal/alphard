# ============================================
# Alphard — Required environment variables
# ============================================
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit secrets.

# ---- Broker: Tinkoff Invest ----
# Get from: https://www.tbank.ru/invest/settings/api
# Sandbox token first — never use real token for development!
TINKOFF_SANDBOX_TOKEN=
TINKOFF_REAL_TOKEN=

# ---- Database ----
POSTGRES_USER=alphard
# POSTGRES_PASSWORD is REQUIRED. Fail-fast: docker compose / portainer
# will not start without it. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=alphard

# ---- Redis ----
# REDIS_PASSWORD is REQUIRED. Fail-fast: docker compose / portainer
# will not start without it. Generate: openssl rand -base64 24
REDIS_PASSWORD=

# ---- LLM endpoints ----
# (configured out-of-band via $AUX_LLM_MODEL / $MAIN_LLM_MODEL in deploy env)
# AUX_LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# MAIN_LLM_MODEL=deepseek/deepseek-v4-flash-0731

# ---- Observability ----
# Required for prometheus/grafana profile. Fail-fast if not set.
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION_DAYS=30

# ---- Logging ----
LOG_LEVEL=INFO
# Log path внутри контейнера. Volume mount: ./logs:/app/logs
LOG_DIR=/app/logs

# ---- Bot behavior ----
RISK_MAX_DD_PCT=10
RISK_MAX_POSITION_PCT=5
RISK_MAX_SECTOR_PCT=30
RISK_MAX_DAILY_LOSS_PCT=3
RISK_ALLOW_SHORT=false  # Set true only if qualified investor with margin
RISK_LEVERAGE_MAX=1.0  # 1.15 if you want leverage

# ---- Capital scaling ----
# Bot auto-detects tier based on account NAV
# micro:    < 1M₽
# small:    1M-10M₽
# mid:      10M-100M₽
# large:    100M-1B₽

# ---- Timeframes ----
DATA_DEFAULT_TIMEFRAME=1d     # daily candles
DATA_HISTORY_YEARS=5         # how much to backfill on first run

# ---- News sources (Phase 5, not wired in Phase 1.3) ----
# NEWS_TELEGRAM_CHANNELS=
# NEWS_RSS_FEEDS=

# ---- Network (for Russian geo routing) ----
# Direct .ru domains, VPN for foreign
PROXY_URL=
