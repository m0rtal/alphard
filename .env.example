# ============================================
# Alphard — Required environment variables
# ============================================
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit secrets.

# ---- Broker: Tinkoff Invest ----
# Get from: https://www.tbank.ru/invest/settings/api
# Sandbox token first — never use real token for development!
TINKOFF_SANDBOX_TOKEN=
TINKOFF_REAL_TOKEN=

# ---- Database ----
POSTGRES_USER=alphard
# POSTGRES_PASSWORD is REQUIRED. Fail-fast: docker compose / portainer
# will not start without it. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=alphard
# POSTGRES_TRUST_SUBNET controls the pg_hba.conf trust range injected by
# the pg-init service (and scripts/init_postgres.sh on recovery).
# Default: 172.16.0.0/12 (Docker bridge range, RFC1918). Override only
# if your alphard-net bridge lives elsewhere (e.g. 172.18.0.0/16) or
# if you want to disable trust entirely (set to 127.0.0.0/32 — verify
# password auth first). See issue #97 for the rationale.
POSTGRES_TRUST_SUBNET=172.16.0.0/12

# ---- Redis ----
# REDIS_PASSWORD is REQUIRED. Fail-fast: docker compose / portainer
# will not start without it. Generate: openssl rand -base64 24
REDIS_PASSWORD=

# ---- LLM endpoints ----
# (configured out-of-band via $AUX_LLM_MODEL / $MAIN_LLM_MODEL in deploy env)
# AUX_LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# MAIN_LLM_MODEL=deepseek/deepseek-v4-flash-0731

# ---- Observability ----
# Required for prometheus/grafana profile. Fail-fast if not set.
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION_DAYS=30

# Grafana provisioning + dashboards — base64-encoded (compose refactor 2.0).
# The grafana service container's entrypoint (docker/entrypoint_grafana.sh)
# decodes each *_B64 variable into /etc/grafana/provisioning/* and
# /var/lib/grafana/dashboards/* on every container start. This avoids the
# .107 PVE LXC bind-mount leaf userns-mapping bug (issue #216 → PR #217
# was a workaround that depended on the host path; this is the final
# fix).
#
# BUGFIX (issue #243 A2, first-shot-friendly): the four B64 values
# below are pre-baked from the source files in docker/grafana/ so that
# an operator can `cp .env.example .env && docker compose up -d` and
# have Grafana start successfully without first running
# ./scripts/quickstart.sh (which would otherwise re-bake these).
# Regenerate with `python3 tools/bake_grafana_env.py` after editing the
# source YAML/JSON files under docker/grafana/.
# Grafana provisioning + dashboards are bind-mounted from the repo.
# See docker-compose.yaml (grafana.volumes) and PR #284/#297.

# ---- Backups ----
# ALPHARD_BACKUP_DIR — where alphard-bot's backup_database.py writes
# pg_dump files (default /mnt/appdata/alphard-backups). Also the source
# directory for the alphard-web /api/backups endpoint. If you change this,
# update the bind-mount in docker-compose.yaml (alphard-web.volumes) to
# match — otherwise the dashboard shows an empty backups table.
ALPHARD_BACKUP_DIR=/mnt/appdata/alphard-backups

# ---- alphard-web security (issue #406) ----
# ALPHARD_WEB_TOKEN — bearer token required on every /api/* request and
# on the HTML root path. The dashboard at .107:8081 is bound to loopback
# only (127.0.0.1:8081:8080 in docker-compose.yaml), so the only way to
# reach it from the LAN is through a reverse proxy that injects this
# token. Generate with:  head -c 32 /dev/urandom | base64
# Leave blank to disable auth (dev mode ONLY — every protected endpoint
# returns sensitive data without this).
ALPHARD_WEB_TOKEN=
